# เทมเพลตของ backend/.env — ก๊อปเป็น .env แล้วเติมค่าจริง (.env ไม่ขึ้น git)

# MySQL connection — DB_HOST / DB_USER / DB_NAME ขาดไม่ได้ ไม่มีแล้ว server ไม่ยอม start
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306
DB_POOL_MAX=10

# HTTP port ของ API server
PORT=5000

# prefix ที่แอปถูก mount ไว้หลัง Apache
# ⚠️ เปลี่ยนค่านี้ต้องเปลี่ยนพร้อมกันกับ APP_BASE ใน frontend/src/utils/config.js,
#    homepage ใน frontend/package.json และ config ของ Apache (อยู่นอก repo)
APP_BASE=/Mecha-Spc-Realtime

# ลายเซ็น token ของการ login หน้า Master — สุ่มยาว ๆ ครั้งเดียวแล้วเก็บไว้ เช่น
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ไม่ตั้งก็ start ได้ แต่ server สุ่มให้ใหม่ทุกครั้ง restart แล้วทุกคนต้อง login ใหม่
# ⚠️ เปลี่ยนค่านี้ = token ที่ออกไปแล้วใช้ไม่ได้ทันที (ทุกคนหลุดจากหน้า Master)
AUTH_SECRET=
# อายุการ login (ชั่วโมง)
AUTH_TOKEN_HOURS=12

# ระบบ Drawing Digital (MECHA1) — ชื่อ DB บน server เดียวกัน ใช้ดึงเครื่องจักร / item / เครื่อง↔item ที่รันได้
# (Master › ข้อมูลพื้นฐาน › ดึงจาก Drawing Digital) · อ่านอย่างเดียว · เว้นว่าง = ปิดฟีเจอร์
DRAWING_DB_NAME=mecha1_drawing_digital
