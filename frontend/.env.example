# frontend/.env.example — ก๊อปเป็น frontend/.env แล้วเติมค่า จากนั้น restart npm start
#
# ⚠️ CRA inline ค่าพวกนี้เข้า bundle ตอน build — token ติดไปกับไฟล์ที่เสิร์ฟให้ทุกคน
#    ยอมรับความเสี่ยงนี้เหมือนโปรเจกต์อื่นในเครือ (ENG_MECHA2, MC_MECHA2, MATERIAL_SYSTEM)

# origin ของ backend — ปล่อยว่างใน production (Apache proxy ให้)
# ตอน dev แยกพอร์ตมีตั้งไว้แล้วที่ frontend/.env.development ไม่ต้องใส่ที่นี่
# REACT_APP_API_ORIGIN=

# ── IPBASS (WOS) ──────────────────────────────────────────────────────────
# ใช้ค้น MOPLAN เพื่อรู้ว่า MO ที่สแกนมาผลิต item อะไร
# ไม่ใส่ก็ใช้งานระบบได้ครบ แค่ต้องเลือก item เองทุกครั้ง
REACT_APP_IPBASS_BASE_URL=http://wbp5.bp.minebea.local/pbass_api
REACT_APP_IPBASS_PLANT=A32LB

# ⚠️ token ผูกกับทั้ง family และ dept — คนละ dept ต้องขอคนละใบ
#    token ใน .env ของโปรเจกต์อื่นหมดอายุหมดแล้ว ห้ามก๊อปมาใช้ ต้องขอใหม่
REACT_APP_IPBASS_TOKEN_MO_PLAN_MP1=
REACT_APP_IPBASS_TOKEN_MO_PLAN_MP2=
